  ],
  "rules": [
    {
      "id": "G01",
      "source": "policy/language-standards.md :: 适用范围",
      "requirement": "适用范围：所有交付物与三类语言，内部内容成为交付物后也适用",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "G02",
      "source": "policy/language-standards.md :: 适用范围",
      "requirement": "适用范围：更具体要求可覆盖默认表达，事实、voice、证据与非空洞原则继续有效，规则冲突须裁决",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "G03",
      "source": "policy/language-standards.md :: 目标",
      "requirement": "目标：每句提供信息或建立逻辑，避免浮夸、机械、空洞和面面俱到",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "G04",
      "source": "policy/language-standards.md :: 目标",
      "requirement": "目标：写作质量与真实作者一致，检测器分数不能决定好坏",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "M01",
      "source": "policy/language-standards.md :: 标点",
      "requirement": "标点：禁用两类长横线、分号，英文使用直引号，允许中文「」",
      "scope": "all",
      "check": "punctuation",
      "manualRequired": false,
      "exemptOriginal": true,
      "terms": []
    },
    {
      "id": "M02",
      "source": "policy/language-standards.md :: 一、机械规则",
      "requirement": "机械规则总例外：直接引用、代码、URL、正式名称及保留原貌的证据须清楚标明",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": true,
      "terms": []
    },
    {
      "id": "M03",
