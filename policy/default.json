    {
      "id": "M04",
      "source": "policy/language-standards.md :: 装饰性副词",
      "requirement": "装饰性副词：列举词仅在无可验证信息、只强调时禁用，携带信息的副词可保留",
      "scope": "all",
      "check": "adverbs",
      "manualRequired": true,
      "exemptOriginal": true,
      "terms": [
        {
          "value": "markedly",
          "conditional": false
        },
        {
          "value": "remarkably",
          "conditional": false
        },
        {
          "value": "strikingly",
          "conditional": false
        },
        {
          "value": "dramatically",
          "conditional": false
        },
        {
          "value": "profoundly",
          "conditional": false
        },
        {
          "value": "exceptionally",
          "conditional": false
        },
        {
          "value": "vastly",
          "conditional": false
        }
      ]
    },
    {
      "id": "M05",
      "source": "policy/language-standards.md :: 装饰性副词",
      "requirement": "删除副词后重新检查节奏与逻辑，不能机械裸删",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "M06",
      "source": "policy/language-standards.md :: 中文禁语",
      "requirement": "中文禁语：原规范全部列举项",
      "scope": "all",
      "check": "chinese-terms",
      "manualRequired": false,
      "exemptOriginal": true,
      "terms": [
        {
          "value": "赋能",
          "conditional": false
        },
        {
          "value": "助力",
          "conditional": false
        },
        {
          "value": "深度剖析",
          "conditional": false
        },
        {
          "value": "深入浅出",
          "conditional": false
        },
        {
          "value": "值得一提",
          "conditional": false
        },
        {
          "value": "值得注意的是",
          "conditional": false
        },
        {
          "value": "不禁让人想到",
          "conditional": false
        },
        {
          "value": "从某种意义上来说",
          "conditional": false
        },
        {
          "value": "在某种程度上",
          "conditional": false
        },
        {
          "value": "毋庸置疑",
          "conditional": false
        }
      ]
    },
    {
      "id": "M07",
      "source": "policy/language-standards.md :: 禁用句式",
      "requirement": "禁用否定转肯定句式，直接表达主张",
      "scope": "all",
      "check": "contrast",
      "manualRequired": true,
      "exemptOriginal": true,
      "terms": []
    },
    {
      "id": "M08",
      "source": "policy/language-standards.md :: 禁用句式",
      "requirement": "无谓的防御性否定应删，确有必要的边界全文只说明一次，并正面定义实际讨论对象",
      "scope": "all",
      "check": "defensive",
      "manualRequired": true,
      "exemptOriginal": true,
      "terms": [
        {
          "value": "this does not mean",
          "conditional": false
        },
        {
          "value": "it is not a claim that",
          "conditional": false
        },
        {
          "value": "this is not",
          "conditional": false
        }
      ]
    },
    {
      "id": "M09",
      "source": "policy/language-standards.md :: 禁用句式",
      "requirement": "冗余短语：按规范替换 in order to、due to the fact that、at the present time，删除两种 note 套话",
      "scope": "all",
      "check": "fillers",
      "manualRequired": false,
      "exemptOriginal": true,
      "terms": [
        {
          "value": "in order to",
          "conditional": false
        },
        {
          "value": "due to the fact that",
          "conditional": false
        },
        {
          "value": "it is important to note that",
          "conditional": false
        },
        {
          "value": "it should be noted that",
          "conditional": false
        },
        {
          "value": "at the present time",
          "conditional": false
        }
      ]
    },
    {
      "id": "M10",
      "source": "policy/language-standards.md :: 禁用句式",
      "requirement": "宣布重要或显著却不说明原因的评价句应删，重要性需机制、后果、证据或对比支撑",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": true,
      "terms": []
    },
    {
      "id": "R01",
      "source": "policy/language-standards.md :: 二、节奏",
      "requirement": "节奏：先处理节奏，再处理词汇",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "R02",
      "source": "policy/language-standards.md :: 二、节奏",
      "requirement": "每段有明显短于、长于平均长度的句子",
      "scope": "all",
      "check": "rhythm-length",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "R03",
      "source": "policy/language-standards.md :: 二、节奏",
      "requirement": "连续三句同主语或同结构开头时至少重构一句",
      "scope": "all",
      "check": "rhythm-opening",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "R04",
      "source": "policy/language-standards.md :: 二、节奏",
      "requirement": "允许通过从句、连词、括号或同位语形成长句，禁止用分号，不用连续极短句制造断奏",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "R05",
      "source": "policy/language-standards.md :: 二、节奏",
      "requirement": "删除成分后保持段内连贯，不能拆成孤立句子",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "L01",
      "source": "policy/language-standards.md :: 保护逻辑连接",
      "requirement": "逻辑连接：保留承担真实关系的中英文连接词，删除后须以连接、回指或合句补回",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "L02",
      "source": "policy/language-standards.md :: 校准对冲",
      "requirement": "对冲：必要判断保留一到两个限定，受控直接结果可直说，观察性、探索性及不完整来源保留限定",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "L03",
      "source": "policy/language-standards.md :: 术语一致",
      "requirement": "同一概念术语一致，必要技术重复优于轮换同义词",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "L04",
      "source": "policy/language-standards.md :: 具体压倒抽象",
      "requirement": "研究性主张须有具体来源、对象、数字或观察，不能无来源概称研究证明",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "L05",
      "source": "policy/language-standards.md :: 具体压倒抽象",
      "requirement": "禁止不在同一尺度上的假范围",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "L06",
      "source": "policy/language-standards.md :: 具体压倒抽象",
      "requirement": "抽象关系要说明主体、机制与结果",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "L07",
      "source": "policy/language-standards.md :: 具体压倒抽象",
      "requirement": "重要判断只说一次，后续增加机制、证据、对比、限制或后果",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "L08",
      "source": "policy/language-standards.md :: 具体压倒抽象",
      "requirement": "空转系词优先简化，直接交代关系",
      "scope": "all",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "V01",
      "source": "policy/language-standards.md :: 学生文字",
      "requirement": "Voice 来自作者与受众，学生须能解释并承担表达，不得过度抛光",
      "scope": "student",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "V02",
      "source": "policy/language-standards.md :: 学生文字",
      "requirement": "允许结构诊断、追问、事实检查和教练反馈，工作稿不能冒充学生原创直接提交",
      "scope": "student",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "V03",
      "source": "policy/language-standards.md :: 学生文字",
      "requirement": "顾问问题紧贴对应正文，点明已知人物、地点、动作或片段，缺事实列准确字段",
      "scope": "advisor-comment",
      "check": "editorial-slots",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": [
        {
          "value": "最近一次",
          "conditional": false
        },
        {
