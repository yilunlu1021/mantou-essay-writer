          "conditional": false
        },
        {
          "value": "哪一段",
          "conditional": false
        },
        {
          "value": "一个具体",
          "conditional": false
        },
        {
          "value": "请给一个",
          "conditional": false
        },
        {
          "value": "什么时候",
          "conditional": false
        },
        {
          "value": "哪一年",
          "conditional": false
        },
        {
          "value": "哪一句",
          "conditional": false
        },
        {
          "value": "某个",
          "conditional": false
        },
        {
          "value": "某段",
          "conditional": false
        },
        {
          "value": "一个",
          "conditional": false
        },
        {
          "value": "一次",
          "conditional": false
        }
      ]
    },
    {
      "id": "V04",
      "source": "policy/language-standards.md :: 学生文字",
      "requirement": "顾问空槽规则仅作用于顾问或 Agent 新写问题和批注，不机械修改学生原文",
      "scope": "advisor-comment",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "V05",
      "source": "policy/language-standards.md :: 学生文书的编辑边界",
      "requirement": "默认 edit，修语法、搭配、指代、重复、必要连接和局部顺序，保留事件顺序、判断、句长与可承担的不完美",
      "scope": "student",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "V06",
      "source": "policy/language-standards.md :: 学生文书的编辑边界",
      "requirement": "edit 不新增场景、动机、主题、因果或结尾含义，不替换成通用申请论点",
      "scope": "student",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "V07",
      "source": "policy/language-standards.md :: 学生文书的编辑边界",
      "requirement": "能局部改则不整段重写，保留有辨识度的长句、直接判断、具体但略笨拙的说法，正确与成熟不足以证明改进",
      "scope": "student",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "V08",
      "source": "policy/language-standards.md :: 学生文书的编辑边界",
      "requirement": "主线、段落功能、主要解释或收束意义变化属于 revision，须用户明确要求并继续满足事实边界",
      "scope": "student",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "N01",
      "source": "policy/language-standards.md :: 个人文书：叙述不能被解释性注释替代",
      "requirement": "以段落功能判断，专业动机可解释选择，未来学习可直接写计划，直述题不强行场景化",
      "scope": "student",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "N02",
      "source": "policy/language-standards.md :: 个人文书：叙述不能被解释性注释替代",
      "requirement": "空泛主句外挂抽象 where / which / whose 意义，不能替代经历的开头与推进",
      "scope": "english-narrative",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "N03",
      "source": "policy/language-standards.md :: 个人文书：叙述不能被解释性注释替代",
      "requirement": "活动转兴趣框架若无具体缘由，应删或改为有来源的行动、选择与后果，换近义词无效",
      "scope": "english-narrative",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "N04",
      "source": "policy/language-standards.md :: 个人文书：叙述不能被解释性注释替代",
      "requirement": "认知动词加并列抽象问句，不能包装宽泛兴趣，需要真实问题及其对下一步的影响",
      "scope": "english-narrative",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "N05",
      "source": "policy/language-standards.md :: 个人文书：叙述不能被解释性注释替代",
      "requirement": "认知改变须有之前判断、触发证据或后续选择的来源，缺少时降低或删除声明",
      "scope": "english-narrative",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "N06",
      "source": "policy/language-standards.md :: 个人文书：叙述不能被解释性注释替代",
      "requirement": "教材式定义仅保留读懂实际问题所需部分，并与经历相连",
      "scope": "english-narrative",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "N07",
      "source": "policy/language-standards.md :: 个人文书：叙述不能被解释性注释替代",
      "requirement": "保留辨明人物、对象、时间和因果的从句，follow / introduce / understand 本身不禁用，不强制碎句、改主语或感官堆砌",
      "scope": "english-narrative",
      "check": "manual",
      "manualRequired": true,
      "exemptOriginal": false,
      "terms": []
    },
    {
      "id": "N08",
      "source": "policy/language-standards.md :: 个人文书：叙述不能被解释性注释替代",
