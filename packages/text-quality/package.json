{
  "name": "@mantou/text-quality",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Versioned text audit and edit validation with explicit policy input",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
